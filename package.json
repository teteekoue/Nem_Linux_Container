{
  "name": "nemlinux-container",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run assets:v86",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run assets:v86",
    "preview": "vite preview",
    "test": "vitest run",
    "test:boot": "node scripts/test-v86-boot.mjs",
    "test:watch": "vitest",
    "assets:v86": "node scripts/copy-v86-assets.mjs",
    "build:alpine": "bash scripts/build-alpine.sh",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@gvibehacker/browser-socket-cloudflare-worker": "^0.1.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "v86": "^0.5.469"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "wrangler": "^4.22.0"
  }
}
